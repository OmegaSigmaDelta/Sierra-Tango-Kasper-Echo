; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/updates_per_second=1

[application]

config/name="Gnoy simulator"
config/version="beta"
run/main_scene="uid://bkhdx0kayl2d"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="res://icon.ico"

[audio]

buses/default_bus_layout="uid://vjwschbyg6nk"

[autoload]

MetSys="*uid://c01ibpvrp2wsd"
CursorManager="*uid://bdarrwsakr1cp"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/mode=2
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://3gqaga1uw70j"

[editor_plugins]

enabled=PackedStringArray("res://addons/MetroidvaniaSystem/EditorExtension/plugin.cfg", "res://addons/MetroidvaniaSystem/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg")

[gui]

common/snap_controls_to_pixels=false
theme/custom_font="uid://bs5rqu6my5lmt"

